rules_version = '2';
// Diary of Emotions - Firestore security rules.
// Publish in: Firebase Console > Firestore Database > Rules (or `firebase deploy --only firestore:rules`).
// These rules are what actually protect your store. Hiding the admin page is NOT security; this is.
service cloud.firestore {
  match /databases/{database}/documents {

    // The one and only administrator (Firebase Auth UID of the owner account).
    function isOwner() {
      return request.auth != null && request.auth.uid == 'J3QSrYKfINYUmCOCBah7lNSf5T83';
    }
    function signedIn() { return request.auth != null; }
    // Real customer accounts (email / Google), not anonymous guest-checkout sessions.
    function isRealUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ---- Catalogue: everyone can read, ONLY the owner can create / change / delete ----
    match /products/{productId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // ---- Store settings, theme, page content: everyone can read, ONLY the owner can write ----
    match /settings/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // ---- Reviews: public to read; signed-in customers can post (validated) and remove their own;
    //      the owner can moderate (edit / delete anything) ----
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isRealUser()
        && request.resource.data.keys().hasOnly(['productId', 'name', 'rating', 'text', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.productId.size() > 0 && request.resource.data.productId.size() < 20
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner();
      allow delete: if isOwner() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // ---- Orders: any visitor (guest or account) may PLACE an order for themselves;
    //      customers can read only their own; ONLY the owner can read all / change status / delete ----
    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['customerUid', 'customerEmail', 'customerName', 'phone', 'address',
                                                  'paymentMethod', 'items', 'subtotal', 'delivery', 'total',
                                                  'status', 'createdAt', 'source'])
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.status == 'pending_confirmation'
        && request.resource.data.createdAt == request.time
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0 && request.resource.data.customerName.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.address is string
        && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 500
        && request.resource.data.paymentMethod in ['UPI', 'COD']
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50
        && request.resource.data.total is number && request.resource.data.total >= 0
        && request.resource.data.subtotal is number && request.resource.data.delivery is number;
      allow read: if isOwner() || (signedIn() && resource.data.customerUid == request.auth.uid);
      allow update, delete: if isOwner();
    }

    // ---- Everything else is locked ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
